generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Condition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum Brand {
  HOTWHEELS
  MAISTO
}

model Miniature {
  id          Int       @id @default(autoincrement())
  name        String
  brand       Brand
  description String
  price       Int
  imgUrl      String
  condition   Condition
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("miniatures")
}
